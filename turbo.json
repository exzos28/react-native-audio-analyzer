{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".nvmrc", ".yarnrc.yml", "tsconfig.base.json"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "nitrogen": {
      "inputs": ["src/specs/**", "nitro.json"],
      "outputs": ["nitrogen/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["lib/**", "nitrogen/**"]
    },
    "typecheck": {
      "dependsOn": ["^nitrogen"],
      "outputs": []
    },
    "test": {
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    },
    "build:android": {
      "dependsOn": ["^nitrogen"],
      "env": ["ANDROID_HOME"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/react-native-audio-analyzer/android/**",
        "$TURBO_ROOT$/packages/react-native-audio-analyzer/cpp/**",
        "$TURBO_ROOT$/packages/react-native-audio-analyzer/libs/miniaudio/miniaudio.h",
        "!android/.gradle/**",
        "!android/build/**",
        "!android/app/build/**"
      ],
      "outputs": []
    },
    "build:ios": {
      "dependsOn": ["^nitrogen"],
      "env": [
        "RCT_REMOVE_LEGACY_ARCH",
        "RCT_USE_RN_DEP",
        "RCT_USE_PREBUILT_RNCORE"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/react-native-audio-analyzer/ios/**",
        "$TURBO_ROOT$/packages/react-native-audio-analyzer/cpp/**",
        "$TURBO_ROOT$/packages/react-native-audio-analyzer/*.podspec",
        "$TURBO_ROOT$/packages/react-native-audio-analyzer/libs/miniaudio/miniaudio.h",
        "!ios/build/**",
        "!ios/Pods/**"
      ],
      "outputs": []
    }
  }
}
